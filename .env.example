# Default: local, persistent hackathon demonstration. No cloud account needed.
PORSI_MODE=demo

# Live mode needs a Supabase project and the supplied database schema.
# Never expose the service role key through a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
