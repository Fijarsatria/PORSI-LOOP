# Default: local, persistent hackathon demonstration. No cloud account needed.
PORSI_MODE=demo
# These are LOCAL demonstration accounts. Configure your own values when hosting demo mode.
DEMO_ADMIN_EMAIL=admin@porsiloop.local
DEMO_ADMIN_PASSWORD=PorsiAdmin2026!
DEMO_SELLER_EMAIL=seller@porsiloop.local
DEMO_SELLER_PASSWORD=PorsiSeller2026!
DEMO_STUDENT_EMAIL=student@porsiloop.local
DEMO_STUDENT_PASSWORD=PorsiStudent2026!
# Other seeded seller emails use DEMO_SELLER_PASSWORD:
# dedi@porsiloop.local, sari@porsiloop.local, hadi@porsiloop.local,
# nusantara@porsiloop.local, roti@porsiloop.local.
# Students can order as guests; no account is required.

# Live mode needs a Supabase project and the supplied database schema.
# Never expose the service role key through a NEXT_PUBLIC variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
# Live digital payments stay disabled until a real payment gateway is integrated.
# Cash is accepted only after the assigned seller confirms receipt.
